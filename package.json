{
  "name": "hyper-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "lefthook install",
    "dev": "concurrently -k -n backend,frontend -c blue,green npm:dev:backend npm:dev:frontend",
    "dev:backend": "uv run -m uvicorn backend.main:app --reload --reload-dir backend",
    "dev:frontend": "vite frontend",
    "format": "uv run ruff format && uv run ruff check --fix && prettier --write -u .",
    "build": "tsc && vite build frontend",
    "lint": "npm run lint:python && npm run lint:ts",
    "lint:python": "uv run ruff format --check && uv run ruff check && pyright",
    "lint:ts": "prettier --check -u . && eslint .",
    "security": "uv run pip-audit && npm audit --audit-level=high && node scripts/check-secrets.mjs",
    "architecture": "uv run lint-imports"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "pyright": "^1.1.414",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5"
  },
  "allowScripts": {
    "lefthook": false
  }
}
